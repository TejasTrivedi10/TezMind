# TezMind Environment Variables
# Copy this file to .env and fill in values.
# NEVER commit .env to version control.

# Optional: Route AI provider calls through the local proxy (apps/proxy)
# Leave empty to call providers directly from the browser (default).
# EXPO_PUBLIC_PROXY_BASE_URL=http://127.0.0.1:3333

# Optional: Expo public env flags
# EXPO_PUBLIC_APP_ENV=development
